# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env (con secretos reales) al repositorio.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
SESSION_COOKIE_AGE=28800

# --- Base de datos ---
# DB_ENGINE=sqlite  -> desarrollo local sin MySQL instalado (valor por defecto)
# DB_ENGINE=mysql   -> produccion / cPanel
DB_ENGINE=sqlite
DB_NAME=simulador_inversiones
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Control de acceso ---
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Parametros del simulador (valores por defecto; cada curso puede
#     definir los suyos desde el panel de administracion) ---
CAPITAL_INICIAL_MXN_DEFAULT=1000000.00
TASA_LIBRE_RIESGO_ANUAL_DEFAULT=0.10
SPREAD_CONVERSION_DIVISAS_DEFAULT=0.005
COMISION_OPERACION_DEFAULT=0.00

# PROVEEDOR_DATOS_MERCADO=sintetico -> no requiere API externa (valor por defecto)
# PROVEEDOR_DATOS_MERCADO=eodhd | twelvedata -> requiere API key real
PROVEEDOR_DATOS_MERCADO=sintetico

# --- Proveedores de datos de mercado reales (opcional, solo si se activan) ---
EODHD_API_KEY=
TWELVEDATA_API_KEY=
